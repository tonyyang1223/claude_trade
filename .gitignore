# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints/

# pytest：测试临时产物（含 DuckDB 临时库，可能上到十几 MB）
.pytest_tmp/
.pytest_cache/


# Data files (keep structure, ignore contents)
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# 历史数据库（DuckDB 单文件，可回填重建，不入库）
data/history/

# Config with sensitive data
config/settings.yaml
config/api_keys.yaml

# Environment
.env

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Course materials
docs/courses/

# AI tool memory (local only)
.workbuddy/
.workbuddy-ai/
