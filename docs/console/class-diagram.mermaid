classDiagram
    %% ===================== 响应信封 / 通用模型 =====================
    %% 信封 {code,message,data} 由 core/envelope.py 构造；前端 client.ts 拦截器解包后即丢弃，
    %% 故 TS 侧不再定义 ApiEnvelope，仅保留失败路径的 ApiError。
    class Envelope {
        +int code
        +string message
        +any data
    }
    class CoinBrief {
        +string id
        +string sym
        +string name
        +int rank
        +float price
        +float mcap
        +float vol
        +float chg24
        +float chg7d
    }
    class NewsItem {
        +string title
        +string url
        +string source
        +string date
        +string kind
    }
    class SectorStat {
        +string cat
        +int count
        +float mcap
        +float avgChg
    }

    %% ===================== 响应模型（data/schemas.py） =====================
    class MarketOverviewResponse {
        +dict meta
        +dict kpi
        +dict distribution
        +CoinBrief[] gainers
        +CoinBrief[] losers
        +CoinBrief[] topByMcap
        +SectorStat[] sectors
    }
    class TokenDetailResponse {
        +CoinBrief basic
        +float ath
        +float athChg
        +dict narrative
        +dict social
        +NewsItem[] news
    }
    class WebResearchResponse {
        +string coinId
        +string description
        +string[] categories
        +dict officialLinks
        +dict communityLinks
        +dict sentiment
        +NewsItem[] news
        +float confidence
    }
    class OpportunityItem {
        +string id
        +float composite
        +dict dims
        +string category
    }
    class OpportunityRadarResponse {
        +dict meta
        +OpportunityItem[] rankings
    }
    class ComparisonProject {
        +string coin_id
        +float total_score
        +string rating
        +string risk_level
        +float[] dims_7
    }
    class ComparisonResponse {
        +ComparisonProject[] projects
        +dict matrix
        +string winner
        +string summary
    }
    class OnchainResponse {
        +string chain
        +string address
        +dict dims
        +float total
        +string decision
        +string risk
        +string position
        +string[] triggers
        +string[] missing
        +dict[] flags
        +string disclaimer
    }
    class ScoreResponse {
        +string coinId
        +dict scores
        +float totalScore
        +string rating
        +string recommendation
        +string riskLevel
        +dict advice
    }
    class MacroResponse {
        +float currentDominance
        +string trend
        +string marketPhase
        +bool altcoinSeason
        +string recommendation
    }
    class MetaResponse {
        +string date
        +int deepTotal
        +int lightTotal
        +int coinCnt
        +string[] availableDates
        +dict weights
    }
    class HealthResponse {
        +string status
        +string version
        +string dataDate
    }

    %% ===================== 后端数据层 =====================
    class DataLoader {
        +resolve_scan_date(date?) string
        +list_scan_dates() string[]
        +load_summary(date) dict
        +load_all_coins(date) list
        +load_by_category_raw(date) dict
        +load_deep_raw(date) dict
        +find_coin_raw(date, coinId) dict
    }
    class Paths {
        +PROJECT_ROOT
        +DAILY_SCAN_DIR
        +resolve_scan_date(date) string
        +list_scan_dates() string[]
    }

    %% ===================== 后端服务层（services/*_svc.py） =====================
    class MarketService {
        +build_meta(date) dict
        +build_overview(date) MarketOverviewResponse
        +build_sectors(date) SectorStat[]
    }
    class TokenService {
        +build_detail(id, date) TokenDetailResponse
    }
    class OpportunityService {
        +compute(date, mcapMax, sort) OpportunityRadarResponse
        -_deep_fields(coinId, deep) dict
    }
    class ChainService {
        +analyze(chain, query, demo) OnchainResponse
    }
    class ScoreService {
        +score(id) ScoreResponse
    }
    class ComparisonService {
        +compare(coinIds) ComparisonResponse
    }
    class MacroService {
        +btc_dominance() MacroResponse
    }
    class WebResearchService {
        +research(id, timeout) (WebResearchResponse, message)
        -_run_with_timeout(func, timeout)
    }
    class CommonHelpers {
        +coin_brief_from_light(c) CoinBrief
        +coin_brief_from_market(mkt, id) CoinBrief
    }

    %% ===================== 路由层（routers/*.py，全部同步 def） =====================
    class MetaRouter {
        +GET /api/health
        +GET /api/meta
    }
    class MarketRouter {
        +GET /api/market/overview
    }
    class TokensRouter {
        +GET /api/tokens/{id}
    }
    class OpportunityRouter {
        +GET /api/opportunity/radar
    }
    class CompareRouter {
        +POST /api/comparison
    }
    class ChainRouter {
        +GET /api/onchain
    }
    class ScoresRouter {
        +GET /api/score/{id}
    }
    class MacroRouter {
        +GET /api/macro/btc-dominance
    }
    class ResearchRouter {
        +POST /api/tokens/{id}/research
    }

    %% ===================== 复用的外部 src 模块（import） =====================
    class SrcWebResearch <<import>> {
        TokenWebResearcher.analyze
    }
    class SrcChain <<import>> {
        chain.orchestrator.analyze
    }
    class SrcScorer <<import>> {
        Scorer.score_project / advice.build_advice
    }
    class SrcBtcDominance <<import>> {
        BTCDominanceAnalyzer.analyze
    }
    class SrcComparison <<import>> {
        ProjectComparator.compare_projects
    }

    %% ===================== 关系 =====================
    MetaRouter ..> MarketService : 调用
    MarketRouter ..> MarketService : 调用
    TokensRouter ..> TokenService : 调用
    OpportunityRouter ..> OpportunityService : 调用
    CompareRouter ..> ComparisonService : 调用
    ChainRouter ..> ChainService : 调用
    ScoresRouter ..> ScoreService : 调用
    MacroRouter ..> MacroService : 调用
    ResearchRouter ..> WebResearchService : 调用

    MarketService ..> DataLoader : 读本地
    MarketService ..> CommonHelpers : 用
    TokenService ..> DataLoader : 读本地
    TokenService ..> CommonHelpers : 用
    OpportunityService ..> DataLoader : 读本地
    DataLoader ..> Paths : 日期/路径

    ChainService ..> SrcChain : import
    ScoreService ..> SrcScorer : import
    ComparisonService ..> SrcComparison : import
    MacroService ..> SrcBtcDominance : import
    WebResearchService ..> SrcWebResearch : import

    MarketService ..> MarketOverviewResponse : 产出
    TokenService ..> TokenDetailResponse : 产出
    OpportunityService ..> OpportunityRadarResponse : 产出
    ComparisonService ..> ComparisonResponse : 产出
    ChainService ..> OnchainResponse : 产出
    ScoreService ..> ScoreResponse : 产出
    MacroService ..> MacroResponse : 产出
    WebResearchService ..> WebResearchResponse : 产出
    MetaRouter ..> MetaResponse : 产出
    MetaRouter ..> HealthResponse : 产出

    Envelope <|-- MarketOverviewResponse
    Envelope <|-- TokenDetailResponse
    Envelope <|-- OpportunityRadarResponse
    Envelope <|-- ComparisonResponse
    Envelope <|-- OnchainResponse
    Envelope <|-- ScoreResponse
    Envelope <|-- MacroResponse
    Envelope <|-- WebResearchResponse

    %% ===================== 前端（TS） =====================
    class ApiClient {
        +get(path, params) Promise~T~
        +post(path, body) Promise~T~
        -拦截器：code===0 解包 data；否则抛 ApiError
        -按端点超时：本地 60s / 分析类 300s
    }
    class ApiError {
        +int code
        +string message
        +any data
    }
    class AppStore {
        +date: string
        +setDate(d)
    }
    class Pages {
        MarketOverview
        TokenProfile
        Comparison
        Onchain
        ScoresAdvice
        HundredXRadar
    }
    ApiClient ..> Envelope : 解包
    ApiClient ..> ApiError : 失败路径
    Pages ..> ApiClient : 请求
    Pages ..> AppStore : 读取 date
